{
  "name": "tabletop-flutter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "cdk-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "npm run dev:server",
    "dev:server": "cdk-blocks dev",
    "generate:spec": "blocks-generate-spec cdk-blocks/index.ts lib/blocks.spec.json",
    "generate:client": "dart run build_runner build --delete-conflicting-outputs && dart format lib/blocks.blocks.dart",
    "generate": "npm run generate:spec && npm run generate:client",
    "build": "flutter build web --release",
    "verify": "npm run typecheck && flutter analyze && flutter test && flutter build web",
    "sandbox": "cdk-blocks sandbox",
    "sandbox:destroy": "cdk-blocks sandbox destroy",
    "sandbox:console": "cdk-blocks sandbox console",
    "cleanup": "cdk-blocks dev stop --all",
    "deploy": "cdk-blocks deploy",
    "destroy": "cdk-blocks destroy",
    "docs": "cdk-blocks docs",
    "docs:search": "cdk-blocks docs --search",
    "docs:api": "cdk-blocks docs --api",
    "db": "cdk-blocks db",
    "whoami": "cdk-blocks whoami",
    "migrate": "cdk-blocks migrate",
    "help": "cdk-blocks --help",
    "generate-client": "cdk-blocks generate client"
  },
  "dependencies": {
    "aws-cdk-blocks": "1.0.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@aws-cdk-blocks/core": "1.0.1",
    "@types/node": "^20.0.0",
    "aws-cdk-lib": "^2.257.0",
    "constructs": "^10.6.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "blocks": {
    "dev": {
      "port": 3001,
      "frontend": false
    }
  }
}
