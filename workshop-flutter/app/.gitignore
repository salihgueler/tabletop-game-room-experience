*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# CDK Hosting staging dir, created by `npm run deploy` during synth
/.hosting/
/coverage/

# Generated from the backend's aws-blocks/index.ts by the regeneration loop in
# every module. Deliberately NOT tracked: the two files are build outputs, and
# their content legitimately differs per module (field order follows whichever
# schema is live), so committing any one version means spurious churn in every
# other module. You create them in module 01 and they never need reviewing.
/lib/blocks.spec.json
/lib/blocks.blocks.dart

# The backend you scaffold in module 01 with `npm create @aws-blocks/blocks-app`.
# Also generated, and also deliberately not tracked: `app/` ships without it on
# purpose so module 01 is a real scaffold rather than a checkout. Every module's
# checkpoint lives in `NN-*/solution/index.ts` instead, which IS tracked.
/backend/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
