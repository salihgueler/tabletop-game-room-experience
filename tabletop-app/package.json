{
  "name": "tabletop-game-room-experience",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "cdk-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:server": "cdk-blocks dev",
    "dev:client": "wait-on tcp:3001 && vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "sandbox": "cdk-blocks sandbox",
    "sandbox:destroy": "cdk-blocks sandbox destroy",
    "sandbox:console": "cdk-blocks sandbox console",
    "cleanup": "cdk-blocks dev stop --all",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "cdk-blocks deploy",
    "destroy": "cdk-blocks destroy",
    "docs": "cdk-blocks docs",
    "docs:search": "cdk-blocks docs --search",
    "docs:api": "cdk-blocks docs --api",
    "db": "cdk-blocks db",
    "whoami": "cdk-blocks whoami",
    "migrate": "cdk-blocks migrate",
    "help": "cdk-blocks --help",
    "generate-client": "cdk-blocks generate client"
  },
  "dependencies": {
    "aws-cdk-blocks": "1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "aws-cdk-lib": "^2.257.0",
    "concurrently": "^8.2.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.27.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.11",
    "wait-on": "^9.0.10"
  },
  "blocks": {
    "dev": {
      "port": 3001,
      "frontend": false
    }
  }
}
